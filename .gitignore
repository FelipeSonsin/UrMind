# Ambientes e segredos locais
.env
.env.*
!.env.example
backend/.venv*/
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Dados grandes e temporários; documentação, metadata e manifestos permanecem versionáveis.
/datasets/raw/*

# Dois artefatos REQUIRED do artifact_registry vivem sob raw/ e sao texto puro
# (indice de populacao do CRDDC e rotulos da selecao), nao imagem. Sem eles a
# cadeia de proveniencia nao fecha num clone limpo. O git nao reinclui arquivo
# dentro de diretorio excluido, entao cada nivel do caminho e reaberto e
# re-excluido com /* antes da excecao final.
!/datasets/raw/rdd2022/
/datasets/raw/rdd2022/*
!/datasets/raw/rdd2022/File_List_CRDDC_RDD2022.txt

!/datasets/raw/global_streetscapes/
/datasets/raw/global_streetscapes/*
!/datasets/raw/global_streetscapes/labels/
/datasets/raw/global_streetscapes/labels/*
!/datasets/raw/global_streetscapes/labels/global_streetscapes_selected.csv
/datasets/processed/
/datasets/downloads/
/datasets/reports/tmp/
/datasets/reports/cache/
/models/
/checkpoints/
/mlruns/
/mlartifacts/
/.cache/
*.part
*.tmp

# Backups lógicos locais de banco podem conter dados e nunca são versionados.
/backups/

# Frontend: artefatos de build e de teste. Migrados de frontend/.gitignore para
# manter um unico .gitignore autoritativo na raiz. node_modules/, .env e
# .env.local ja estavam cobertos pelas regras globais acima.
/frontend/dist/
/frontend/test-results/
/frontend/playwright-report/
*.tsbuildinfo

# Certificado TLS de desenvolvimento (gerado por scripts/dev_https_cert.py).
/certs/
