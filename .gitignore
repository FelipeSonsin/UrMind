# Ambientes e segredos locais
.env
.env.*
!.env.example
backend/.venv*/
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Dados grandes e temporários; documentação, metadata e manifestos permanecem versionáveis.
/datasets/raw/*

# Registro de rótulos de uma fonte bruta mantida no catálogo.
!/datasets/raw/global_streetscapes/
/datasets/raw/global_streetscapes/*
!/datasets/raw/global_streetscapes/labels/
/datasets/raw/global_streetscapes/labels/*
!/datasets/raw/global_streetscapes/labels/global_streetscapes_selected.csv
/datasets/processed/
/datasets/downloads/
/datasets/reports/tmp/
/datasets/reports/cache/
/models/
/checkpoints/
/mlruns/
/mlartifacts/
/.cache/
*.part
*.tmp

# Integrações opcionais: credenciais e saídas grandes nunca entram no Git.
/.kaggle/
kaggle.json
/simulation/outputs/
/robot/webots/outputs/

# Backups lógicos locais de banco podem conter dados e nunca são versionados.
/backups/

# Frontend: artefatos de build e de teste. Migrados de frontend/.gitignore para
# manter um unico .gitignore autoritativo na raiz. node_modules/, .env e
# .env.local ja estavam cobertos pelas regras globais acima.
/frontend/dist/
# Pesos da detecção ao vivo (35 MB) não são versionados; o build os obtém e confere o SHA-256.
/frontend/public/models/*.onnx
# O manifesto do navegador é versionado: fixa o ONNX por SHA-256 (frontend/build/liveModel.ts).
/frontend/test-results/
/frontend/playwright-report/
*.tsbuildinfo

# Certificado TLS de desenvolvimento (gerado por scripts/dev_https_cert.py).
/certs/
