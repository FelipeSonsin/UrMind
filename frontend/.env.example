# O proxy do Vite encaminha /api para o FastAPI local (desenvolvimento e preview).
API_PROXY_TARGET=http://127.0.0.1:8000
# Em produção, prefira /api na mesma origem, servido pelo seu reverse proxy.
VITE_API_BASE_URL=/api/v1
# Provider principal MapLibre. OpenFreeMap preserva attribution OSM no style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Fallback CARTO opcional. Toda variável VITE_* é pública no navegador:
# restrinja esta key por origem/referer e nunca use segredos de servidor aqui.
VITE_CARTO_BASEMAPS_API_KEY=
# Supabase Auth no navegador: só a URL base e a PUBLISHABLE key (nunca a secret).
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui
# HTTPS de desenvolvimento (camera/GPS no celular pela rede local). Producao usa
# o TLS do servidor/proxy; este certificado e apenas local.
# VITE_DEV_HTTPS=1
# Câmera do robô (celular → notebook por WebRTC). Só o endereço STUN público, sem
# usuário nem senha. Sem esta variável a Câmera do robô não inicia e avisa na tela.
# A sinalização usa o Supabase Realtime do mesmo projeto (VITE_SUPABASE_*).
VITE_ROBOT_CAMERA_STUN_URL=stun:stun.cloudflare.com:3478
