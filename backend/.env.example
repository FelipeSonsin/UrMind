# PostgreSQL/PostGIS do Supabase (SQLAlchemy 2 + psycopg 3). Unico acesso a dados
# do backend (MASTER_PLAN 4.3). Sem Docker: tudo roda em Python nativo.
#
# Arquitetura oficial: runtime e migrations usam o Supavisor em SESSION MODE,
# porta 5432 (IPv4). Supabase > Connect > Session pooler.
# Senha com caracteres reservados deve ir percent-encoded (ex.: @ -> %40).
# Host *.supabase.co/.com exige TLS: sem sslmode aplica-se require; sslmode que
# admita texto claro (disable/allow/prefer) e recusado. O transaction pooler
# (porta 6543) e recusado pelo runtime e pelas migrations.
#
# Runtime do FastAPI. Sem esta variavel a API sobe, mas as rotas de dominio
# respondem 503.
DATABASE_POOLER_URL='postgresql+psycopg://postgres.<PROJECT_REF>:<ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require'
#
# Alembic. Tem prioridade sobre DATABASE_URL.
MIGRATION_DATABASE_URL='postgresql+psycopg://postgres.<PROJECT_REF>:<ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require'
#
# OPTIONAL DIRECT CONNECTION / LEGACY FALLBACK. Nao e usada pelo runtime; o
# Alembic so a le se MIGRATION_DATABASE_URL estiver vazia. O host direto
# db.<PROJECT_REF>.supabase.co e IPv6: pode nao funcionar em redes sem IPv6.
# DATABASE_URL='postgresql+psycopg://postgres:<ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require'
# Origens do PWA autorizadas quando ele NAO estiver na mesma origem da API.
# Vazio = sem CORS (mesma origem via reverse proxy, ou proxy do Vite em dev).
# "*" e recusado; fora de localhost exige https.
# CORS_ALLOWED_ORIGINS=https://app.exemplo.org
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Supabase API/Auth. Ainda nao consumidas pelo codigo: Storage e Auth chegam no
# passo 3 do MASTER_PLAN 25. SUPABASE_URL e so a base, sem /rest/v1.
SUPABASE_URL=https://seu-projeto.supabase.co
# Publishable: pode ir a componentes client-side.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui
# Secret: SERVER ONLY. Nunca no frontend, em log, resposta HTTP ou arquivo versionado.
SUPABASE_SECRET_KEY=sb_secret_substitua_aqui
# JWT de usuario deve ser validado por este JWKS, nunca pela secret key.
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# Raiz dos datasets. NAO defina em uso normal: o padrao e datasets/ dentro do
# projeto, e e assim que o projeto se mantem portatil entre maquinas.
# A variavel existe apenas como escape para uma maquina especifica cujo disco
# nao comporte os dados; ela nunca deve ser versionada com valor.
# URMIND_DATASETS_DIR=

# Camera do Scout para o painel publico. Sem valor, as rotas de camera respondem
# 503 e o painel declara "sem camera conectada" — nunca simula transmissao.
# SCOUT_FRAME_URL=http://192.168.0.50/snapshot.jpg
# SCOUT_STREAM_URL=http://192.168.0.50/stream.mjpg
# Espectadores simultaneos no repasse de video (o excedente recebe 503).
PUBLIC_STREAM_MAX_CLIENTS=4
