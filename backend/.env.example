# Conexao direta ao PostgreSQL/PostGIS do Supabase (SQLAlchemy 2 + psycopg 3).
# Supabase > Project Settings > Database > Connection string (session pooler).
# Unico acesso a dados do backend (MASTER_PLAN 4.3).
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Ainda nao consumidas pelo codigo. Passam a ser obrigatorias quando o passo 3
# do MASTER_PLAN 25 (Storage + Capture) e o Worker forem implementados.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua_aqui

# Raiz dos datasets. NAO defina em uso normal: o padrao e datasets/ dentro do
# projeto, e e assim que o projeto se mantem portatil entre maquinas.
# A variavel existe apenas como escape para uma maquina especifica cujo disco
# nao comporte os dados; ela nunca deve ser versionada com valor.
# URMIND_DATASETS_DIR=
