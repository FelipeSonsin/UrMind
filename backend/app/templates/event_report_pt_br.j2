{# Relatório de evento — MASTER_PLAN §15.

   Regra do template: ele só pode falar o que existe no resultado. Todo bloco é
   condicional; dado ausente vira "não disponível" ou é omitido. Não há texto de
   preenchimento, não há adjetivo que o dado não sustente, e nenhuma frase é
   gerada por LLM.

   O ambiente usa trim_blocks + lstrip_blocks: as tags de bloco ficam em linha
   própria e não deixam rastro na saída.
#}
OCORRÊNCIA {{ report.event_key }}

Problema: {{ report.class_label }}
{% if report.visual_confidence is not none %}
Confiança da detecção: {{ '%.0f'|format(report.visual_confidence * 100) }}%
{% else %}
Confiança da detecção: não disponível
{% endif %}
{% if report.model_version %}
Modelo: {{ report.model_version }}
{% else %}
Modelo: não disponível (resultado não veio de modelo promovido)
{% endif %}

LOCALIZAÇÃO
{% if report.latitude is not none and report.longitude is not none %}
Coordenada informada: {{ '%.6f'|format(report.latitude) }}, {{ '%.6f'|format(report.longitude) }}
{% if report.location_accuracy_m is not none %}
Precisão declarada: ±{{ '%.0f'|format(report.location_accuracy_m) }} m
{% else %}
Precisão declarada: não disponível
{% endif %}
{% if report.location_source %}
Origem da coordenada: {{ report.location_source }}
{% endif %}
{% else %}
Coordenada: não disponível — este registro ainda não tem posição no mapa.
{% endif %}
{% if report.road_segment_name %}
Trecho associado: {{ report.road_segment_name }}
{% if report.distance_to_road_m is not none %}
Distância entre o ponto informado e o trecho: {{ '%.1f'|format(report.distance_to_road_m) }} m
{% endif %}
{% elif report.latitude is not none %}
