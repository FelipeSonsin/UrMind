{% endif %}
{% if report.address %}
Endereço aproximado: {{ report.address }}
{% endif %}

EVIDÊNCIAS
{% if report.evidence %}
{% for item in report.evidence %}
- {{ item }}
{% endfor %}
{% else %}
- não disponível
{% endif %}

AVALIAÇÃO
Severidade: {{ report.severity_label }}
{% if report.priority_score is not none %}
Prioridade: {{ '%.2f'|format(report.priority_score) }} de 1,00
{% else %}
