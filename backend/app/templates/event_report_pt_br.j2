{% endif %}
{% if report.uncertainty is not none %}
Incerteza: {{ '%.2f'|format(report.uncertainty) }} de 1,00
{% endif %}
{% if report.coverage is not none %}
Fatores disponíveis: {{ '%.0f'|format(report.coverage * 100) }}% do peso total da regra
{% endif %}
{% if report.ruleset_version %}
Regra aplicada: {{ report.ruleset_version }}
{% endif %}

RESPONSÁVEL
{% if report.responsible %}
Sugerido: {{ report.responsible }}
{% if report.responsibility_source %}
